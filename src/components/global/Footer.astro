---
import { Image } from "astro:assets";
import Roofline from "@/components/content/Roofline.astro";
import logo from "@/assets/logo/d7bau-white.png";
import { SITE_NAME } from "@/consts.ts";
import { localizePath, toLocale } from "@/i18n/locales.ts";
import { useTranslations } from "@/i18n/ui.ts";
import { getMessages } from "@/i18n/messages.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const m = getMessages(locale);
const home = localizePath(locale);
---

{render && (
  <footer class="footer_wrap theme-dark">
    <div class="footer_inner">
      <div class="footer_top">
        <div class="footer_brand">
          <Roofline />
          <a class="footer_logo text-style-h4" href={home}>
            {SITE_NAME}
          </a>
          <p class="footer_tagline">{m.footerTagline}</p>
        </div>
        <nav aria-label={t("nav.footer")}>
          <ul class="footer_links">
            <li>
              <a class="footer_link" href={`${home}#project`}>
                {m.navProject}
              </a>
            </li>
            <li>
              <a class="footer_link" href={`${home}#prices`}>
                {m.navPrices}
              </a>
            </li>
            <li>
              <a class="footer_link" href={`${home}#about`}>
                {m.navAboutUs}
              </a>
            </li>
            <li>
              <a class="footer_link" href={`${home}#contact`}>
                {m.navContact}
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="footer_bottom">
        <p class="footer_copyright text-style-small">
          &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
          {m.footerCopyright}
        </p>
        <ul class="footer_links">
          <li>
            <a class="footer_link" href={localizePath(locale, "gdpr")}>
              {m.footerPrivacyPolicy}
            </a>
          </li>
          <li>
            <a class="footer_link" href={localizePath(locale, "impressum")}>
              {m.footerTermsOfService}
            </a>
          </li>
          <li>
            <button class="footer_link" type="button" data-consent-open>
              {m.footerCookiePolicy}
            </button>
          </li>
          <li>
            <a
              class="footer_link"
              href="https://pictusweb.sk"
              target="_blank"
              rel="noopener"
            >
              &lt;/&gt; pictusweb.sk
            </a>
          </li>
        </ul>
        <a
          class="footer_company"
          href="https://d7bau.at"
          target="_blank"
          rel="noopener"
          aria-label="D7 BAU GmbH"
        >
          <Image src={logo} alt="" width={120} />
        </a>
      </div>
    </div>
  </footer>
)}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .footer_brand {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      max-width: 30rem;
    }

    .footer_logo {
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_tagline {
      color: var(--text-2);
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_link {
      color: var(--text-2);
      font-weight: inherit;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4) var(--space-6);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }

    .footer_company {
      width: 6rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }
  }
</style>
