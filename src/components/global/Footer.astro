---
import { Image } from "astro:assets";
import logo from "@/assets/logo/d7bau-white.png";
import { localizePath, toLocale } from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const m = getMessages(locale);
const year = new Date().getFullYear();
---

{render && (
  <footer class="footer_wrap">
    <div class="footer_container">
      <div class="footer_top" data-reveal="up">
        <div class="footer_logo">
          <Image src={logo} alt="d7bau_logo" width={550} />
        </div>
        <p class="footer_tagline">{m.footerTagline}</p>
      </div>
      <div class="footer_bottom">
        <span class="footer_rule" data-reveal="rule" />
        <div class="footer_legal" data-reveal="up" style="--reveal-delay: 0.5s">
          <p class="footer_copyright">
            © {year} {m.footerCopyright}
          </p>
          <ul class="footer_links">
            <li>
              <a class="footer_link" href={localizePath(locale, "gdpr")}>
                {m.footerPrivacyPolicy}
              </a>
            </li>
            <li>
              <a class="footer_link" href={localizePath(locale, "impressum")}>
                {m.footerTermsOfService}
              </a>
            </li>
            <li>
              <button class="footer_link" type="button" data-consent-open>
                {m.footerCookiePolicy}
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
)}

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      padding-block: 3rem 5.5rem;
      background-color: var(--dark-900);
      color: var(--light-100);
      font-size: 1.21875rem;
      font-weight: 200;

      @media (width >= 48rem) {
        padding-block: 3rem;
      }

      @media (width >= 64rem) {
        padding-block: 4rem;
      }
    }

    .footer_container {
      width: 100%;
      max-width: 80rem;
      margin-inline: auto;
      padding-inline: 1rem;

      @media (width >= 40rem) and (width < 48rem) {
        max-width: 40rem;
      }

      @media (width >= 48rem) and (width < 64rem) {
        max-width: 48rem;
      }

      @media (width >= 64rem) and (width < 80rem) {
        max-width: 64rem;
      }
    }

    .footer_top {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;

      @media (width >= 64rem) {
        flex-direction: row;
      }
    }

    .footer_logo {
      width: min(18.46875rem, 100%);
      margin-bottom: 1.5rem;

      & img {
        width: 55%;
        margin-left: auto;

        @media (width >= 64rem) {
          width: 75%;
          margin-left: -6%;
        }
      }
    }

    .footer_tagline {
      max-width: 75%;
      margin-bottom: 2rem;
      color: rgb(255 255 255 / 0.9);
      font-family: var(--script-family);
      font-size: 1.875rem;
      font-style: italic;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 0.25em;
      text-align: right;
      text-shadow: 0.0625rem 0.0625rem 0.125rem rgb(0 0 0 / 0.3);

      @media (width >= 64rem) {
        font-size: 2.5rem;
      }
    }

    .footer_bottom {
      position: relative;
      margin-top: 4rem;
      padding-top: 2rem;
    }

    .footer_rule {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0.0625rem;
      background: var(--gold-gradient);
      box-shadow: 0 0 0.5rem rgb(212 175 55 / 0.4);
    }

    @media (prefers-reduced-motion: no-preference) {
      .js-reveal .footer_rule[data-reveal] {
        width: 0;
        opacity: 1;
        transition: width 1.2s ease-in-out;

        &.is-revealed {
          width: 100%;
        }
      }
    }

    .footer_legal {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;

      @media (width >= 48rem) {
        flex-direction: row;
      }
    }

    .footer_copyright {
      margin-bottom: 1rem;
      color: rgb(255 255 255 / 0.6);
      font-size: 0.875rem;
      line-height: 1.25rem;

      @media (width >= 48rem) {
        margin-bottom: 0;
      }
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      padding: 0;
      list-style: none;

      @media (width >= 48rem) {
        justify-content: flex-end;
      }
    }

    .footer_link {
      position: relative;
      display: block;
      margin-block: -0.375rem;
      padding-block: 0.375rem;
      color: rgb(255 255 255 / 0.6);
      font: inherit;
      font-size: 0.875rem;
      line-height: 1.25rem;
      cursor: pointer;
      transition: color 300ms;

      &::after {
        content: "";
        position: absolute;
        bottom: 0.125rem;
        left: 0;
        width: 0;
        height: 0.0625rem;
        background-color: var(--brand-500);
        transition: width 300ms;
      }

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);

          &::after {
            width: 100%;
          }
        }
      }
    }
  }
</style>
