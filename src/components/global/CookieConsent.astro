---
import { ANALYTICS_SRC, ANALYTICS_WEBSITE_ID } from "@/consts.ts";
import { localizePath, toLocale } from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const m = getMessages(locale);
---

{render && (
  <aside
    class="cookie-consent_wrap"
    aria-label={m.footerCookiePolicy}
    data-analytics-src={ANALYTICS_SRC}
    data-analytics-id={ANALYTICS_WEBSITE_ID}
    hidden
  >
    <p class="cookie-consent_text">
      {m.cookies}{" "}
      <a href={`${localizePath(locale, "gdpr")}#cookies`}>
        {m.footerPrivacyPolicy}
      </a>
    </p>
    <div class="cookie-consent_actions">
      <button class="cookie-consent_button" type="button" data-consent="denied">
        {m.cookiesDisagree}
      </button>
      <button
        class="cookie-consent_button accept"
        type="button"
        data-consent="granted"
      >
        {m.cookiesAgree}
      </button>
    </div>
  </aside>
)}

<script>
  const KEY = "d7quattro-consent";
  const banner = document.querySelector<HTMLElement>(".cookie-consent_wrap");

  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  const write = (value: string) => {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      return;
    }
  };

  const loadAnalytics = () => {
    const src = banner?.dataset.analyticsSrc;
    const id = banner?.dataset.analyticsId;
    if (!src || !id || document.querySelector(`script[src="${src}"]`)) return;

    const script = document.createElement("script");
    script.defer = true;
    script.src = src;
    script.dataset.websiteId = id;
    document.head.append(script);
  };

  if (banner) {
    const choice = read();
    if (choice === "granted") loadAnalytics();
    if (!choice) banner.hidden = false;

    banner.querySelectorAll<HTMLElement>("[data-consent]").forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.consent ?? "denied";
        write(value);
        banner.hidden = true;
        if (value === "granted") loadAnalytics();
      });
    });

    document
      .querySelectorAll<HTMLElement>("[data-consent-open]")
      .forEach((trigger) => {
        trigger.addEventListener("click", () => {
          banner.hidden = false;
          banner.querySelector<HTMLElement>("[data-consent]")?.focus();
        });
      });
  }
</script>

<style is:global>
  @layer components {
    .cookie-consent_wrap {
      position: fixed;
      inset: auto 0 0;
      z-index: 999;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      padding: 1rem 1.5rem;
      background: rgb(59 58 58 / 0.95);
      color: #fff;
      border-top: 0.0625rem solid var(--gold-glow);
      box-shadow: 0 -0.3125rem 1.25rem rgb(0 0 0 / 0.3);
      font-size: 1rem;
      font-weight: 200;
      line-height: 1.5;
      backdrop-filter: blur(0.625rem);

      @media (width < 48rem) {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        line-height: 1.4;
      }

      &[hidden] {
        display: none;
      }
    }

    .cookie-consent_text {
      flex: 1 0 18.75rem;

      & a {
        text-decoration: underline;
      }
    }

    .cookie-consent_actions {
      display: flex;
      align-items: center;

      @media (width < 48rem) {
        gap: 0.75rem;
        width: 100%;
        margin-top: 0.625rem;

        & .cookie-consent_button,
        & .cookie-consent_button.accept {
          flex: 1;
          margin: 0;
          text-align: center;
          padding: 0.5rem 1rem;
          border: 0.125rem solid var(--brand-500);
        }
      }
    }

    .cookie-consent_button {
      margin: 0.9375rem 1.5625rem 0.9375rem 0.9375rem;
      padding: 0.5rem 1.5rem;
      background: transparent;
      color: #fff;
      border: 0.125rem solid var(--brand-500);
      border-radius: 0.5rem;
      font: inherit;
      font-weight: var(--primary-bold);
      cursor: pointer;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;

      &.accept {
        margin: 0.9375rem;
        padding: 0.625rem 1.5rem;
        background: #d4ae36;
        color: #0e0d0d;
        border: 0;
      }
    }
  }
</style>
