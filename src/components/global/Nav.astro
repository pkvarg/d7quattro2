---
import { Image } from "astro:assets";
import logo from "@/assets/logo/d7bau-white.png";
import LocaleSwitcher from "@/components/global/LocaleSwitcher.astro";
import { SITE_NAME } from "@/consts.ts";
import { localizePath, toLocale, type Locale } from "@/i18n/locales.ts";
import { useTranslations } from "@/i18n/ui.ts";
import { getMessages } from "@/i18n/messages.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** `main` fixes the full menu over the page; `pages` is a plain bar with the logo and languages. */
  variant?: "main" | "pages";
  /** Locales this page exists in. Defaults to every locale. */
  translations?: readonly Locale[];
}

const { render = true, variant = "main", translations } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const m = getMessages(locale);
const home = localizePath(locale);

const links = [
  { label: m.navAboutUs, href: `${home}#about` },
  { label: m.navProject, href: `${home}#project` },
  { label: m.navPrices, href: `${home}#prices` },
  { label: m.navContact, href: `${home}#contact` },
];
---

{render && variant === "pages" && (
  <header class="nav_wrap pages">
    <a class="nav_logo" href={home} aria-label={SITE_NAME}>
      <Image src={logo} alt="" width={250} loading="eager" />
    </a>
    <LocaleSwitcher translations={translations} />
  </header>
)}

{render && variant === "main" && (
  <header class="nav_wrap">
    <div class="nav_inner">
      <a class="nav_logo" href={home} aria-label={SITE_NAME}>
        <Image src={logo} alt="" width={250} loading="eager" />
      </a>
      <nav class="nav_desktop" aria-label={t("nav.main")}>
        <ul class="nav_links">
          {links.map((link) => (
            <li>
              <a class="nav_link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <LocaleSwitcher translations={translations} />
      </nav>
      <button
        class="nav_toggle"
        type="button"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon">
          <span />
          <span />
          <span />
        </span>
      </button>
    </div>
    <nav class="nav_menu" id="nav-menu" aria-label={t("nav.menu")}>
      <ul class="nav_menu_links">
        {links.map((link) => (
          <li>
            <a class="nav_menu_link" href={link.href}>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <LocaleSwitcher translations={translations} />
    </nav>
  </header>
)}

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link) return;

    const url = new URL(link.href);
    const samePage =
      url.origin === location.origin && url.pathname === location.pathname;
    const target = document.getElementById(
      decodeURIComponent(url.hash.slice(1)),
    );
    if (!samePage || !target || target instanceof HTMLDialogElement) return;

    event.preventDefault();
    target.scrollIntoView();
    if (target.hasAttribute("tabindex")) target.focus({ preventScroll: true });
  });

  if (location.hash) {
    const settle = () => {
      const target = document.getElementById(
        decodeURIComponent(location.hash.slice(1)),
      );
      history.replaceState(
        history.state,
        "",
        location.pathname + location.search,
      );
      target?.scrollIntoView({ behavior: "instant" });
    };
    if (document.readyState === "complete") settle();
    else addEventListener("load", settle);
  }

  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const menu = nav?.querySelector<HTMLElement>(".nav_menu");

  if (nav && toggle && menu) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.inert = !open;
    };

    setOpen(false);

    toggle.addEventListener("click", () =>
      setOpen(!nav.classList.contains("is-open")),
    );

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    const onScroll = () => nav.classList.toggle("scrolled", scrollY > 10);
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style is:global>
  @layer components {
    html {
      scroll-behavior: smooth;
    }

    .nav_wrap {
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      padding-block: 0.75rem;
      background-color: #3c3b3b;
      color: var(--light-100);
      border-bottom: 0.25rem solid transparent;
      border-image-source: var(--gold-gradient);
      border-image-slice: 1;
      transition: box-shadow 300ms ease-in-out;

      &.scrolled {
        box-shadow:
          0 0.25rem 0.375rem -0.0625rem rgb(0 0 0 / 0.1),
          0 0.125rem 0.25rem -0.125rem rgb(0 0 0 / 0.1);
      }
    }

    .nav_wrap.pages {
      position: static;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 2rem;
    }

    .nav_inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 80rem;
      margin-inline: auto;
      padding-inline: 1rem;

      @media (width >= 40rem) {
        padding-inline: 1.5rem;
      }

      @media (width >= 64rem) {
        padding-inline: 2rem;
      }
    }

    .nav_logo {
      flex-shrink: 0;
      width: 7.8125rem;
    }

    .nav_desktop {
      display: none;
      align-items: center;
      gap: 2rem;

      @media (width >= 48rem) {
        display: flex;
      }
    }

    .nav_links {
      display: flex;
      align-items: center;
      gap: 2rem;
      padding: 0;
      list-style: none;
    }

    .nav_link {
      position: relative;
      font-size: 1.125rem;
      font-weight: var(--primary-medium);
      line-height: 1.75rem;
      letter-spacing: 0.025em;
      text-transform: uppercase;
      transition: color 300ms;

      &::after {
        content: "";
        position: absolute;
        bottom: -0.25rem;
        left: 0;
        width: 0;
        height: 0.125rem;
        background-color: var(--brand-500);
        transition: width 300ms;
      }

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);

          &::after {
            width: 100%;
          }
        }
      }
    }

    .nav_toggle {
      padding: 0.5rem;
      border-radius: 0.375rem;
      color: var(--brand-500);

      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: 1.5rem;
      height: 1.25rem;

      & span {
        position: absolute;
        left: 0;
        width: 1.5rem;
        height: 0.125rem;
        background-color: var(--brand-500);
        transition:
          transform 300ms ease-in-out,
          opacity 300ms ease-in-out,
          top 300ms ease-in-out;
      }

      & span:nth-child(1) {
        top: 0;
      }

      & span:nth-child(2) {
        top: 0.5rem;
      }

      & span:nth-child(3) {
        top: 1rem;
      }
    }

    .nav_wrap.is-open .nav_toggle_icon {
      & span:nth-child(1) {
        top: 0.5rem;
        transform: rotate(45deg);
      }

      & span:nth-child(2) {
        opacity: 0;
      }

      & span:nth-child(3) {
        top: 0.5rem;
        transform: rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      inset: 100% 0 auto;
      max-height: 0;
      background-color: #3c3b3b;
      border-top: 0.0625rem solid var(--brand-500);
      box-shadow:
        0 0.625rem 0.9375rem -0.1875rem rgb(0 0 0 / 0.1),
        0 0.25rem 0.375rem -0.25rem rgb(0 0 0 / 0.1);
      overflow: hidden;
      transition: max-height 300ms ease-in-out;

      @media (width >= 48rem) {
        display: none;
      }
    }

    .nav_wrap.is-open .nav_menu {
      max-height: 24rem;
      border-bottom: 0.0625rem solid var(--brand-500);
    }

    .nav_menu_links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem 1.5rem 1rem;
      list-style: none;
    }

    .nav_menu_link {
      display: block;
      padding-block: 0.5rem;
      font-size: 1.5625rem;
      font-weight: var(--primary-medium);
      transition: color 300ms;

      & span {
        padding-bottom: 0.25rem;
        border-bottom: 0.0625rem solid transparent;
        transition: border-color 300ms;
      }

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);

          & span {
            border-color: var(--brand-500);
          }
        }
      }
    }

    .nav_menu .locale-switcher_wrap {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
