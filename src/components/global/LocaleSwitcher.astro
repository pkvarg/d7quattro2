---
import {
  LOCALE_NAMES,
  LOCALE_TAGS,
  LOCALES,
  localizePath,
  toLocale,
  translatePath,
  type Locale,
} from "@/i18n/locales.ts";
import { useTranslations } from "@/i18n/ui.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Locales this page exists in. Other locales link to their home page. */
  translations?: readonly Locale[];
}

const { render = true, translations = LOCALES } = Astro.props;

const current = toLocale(Astro.currentLocale);
const t = useTranslations(current);

const order: readonly Locale[] = ["de", "sk", "en"];

const links = order.map((locale) => ({
  locale,
  href:
    (translations.includes(locale) &&
      translatePath(Astro.url.pathname, locale)) ||
    localizePath(locale),
}));
---

{render && (
  <ul class="locale-switcher_wrap" aria-label={t("nav.language")}>
    {links.map(({ locale, href }) => (
      <li>
        <a
          class="locale-switcher_link"
          href={href}
          hreflang={LOCALE_TAGS[locale]}
          lang={locale}
          aria-label={LOCALE_NAMES[locale]}
          aria-current={locale === current ? "true" : undefined}
        >
          {locale}
        </a>
      </li>
    ))}
  </ul>
)}

<style is:global>
  @layer components {
    .locale-switcher_wrap {
      display: flex;
      gap: 1rem;
      margin-right: 0.5rem;
      padding: 0.25rem;
      font-size: 1.25rem;
      line-height: 1.5;
      list-style: none;
    }

    .locale-switcher_link {
      position: relative;
      display: inline-block;
      padding: 0.25rem 0.5rem;
      font-weight: var(--primary-medium);
      text-transform: uppercase;
      transition:
        color 300ms,
        transform 300ms;

      &::after {
        content: "";
        position: absolute;
        bottom: -0.25rem;
        left: 0;
        width: 0;
        height: 0.125rem;
        background-color: var(--brand-500);
        transition: width 300ms;
      }

      &[aria-current="true"] {
        color: var(--brand-500);

        &::after {
          width: 100%;
        }
      }

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
          transform: scale(1.1);

          &::after {
            width: 100%;
          }
        }
      }
    }
  }
</style>
