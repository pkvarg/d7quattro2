---
import { Image, getImage } from "astro:assets";
import SectionTitle from "@/components/content/SectionTitle.astro";
import GoldButton from "@/components/content/GoldButton.astro";
import LocationMap from "@/components/content/LocationMap.astro";
import { localizePath, toLocale } from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";
import { useTranslations } from "@/i18n/ui.ts";
import { exteriorImages, interiorImages } from "@/utils/gallery.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const m = getMessages(locale);
const t = useTranslations(locale);
const home = localizePath(locale);

const gallery = Array.from({ length: 16 }, (_, index) => {
  const exterior = index % 2 === 0;
  const position = Math.floor(index / 2);
  return {
    src: (exterior ? exteriorImages : interiorImages)[position],
    alt: `Luxury Home ${exterior ? "Exterior" : "Interior"} View ${position + 1}`,
  };
}).filter((image) => image.src);

const enlarged = await Promise.all(
  gallery.map(async (image) => ({
    src: (await getImage({ src: image.src, width: 1920 })).src,
    alt: image.alt,
  })),
);

const plan = (name: string, file: string) => ({
  name,
  href: `/plans/${file}.pdf`,
});

const documents = [
  plan("Grundriss EG", "grundriss-eg"),
  plan("Grundriss OG", "grundriss-og"),
  plan("Lageplan A", "lageplan-a"),
  plan("Lageplan PG", "lageplan-pg"),
  ...[1, 2, 3, 4].flatMap((unit) => [
    plan(`Wohnung 1-${unit} EG`, `wohnung-1-${unit}-eg`),
    plan(`Wohnung 1-${unit} OG`, `wohnung-1-${unit}-og`),
  ]),
];

const features = [
  { title: m.architecturalTitle, text: m.architecturalDescription },
  { title: m.qualityTitle, text: m.qualityDescription },
  { title: m.sustainableTitle, text: m.sustainableDescription },
];
---

{render && (
  <section class="project_wrap page-section" id="project">
    <div class="page-container">
      <SectionTitle title={m.projectTitle} text={m.projectDescription} />

      <div class="project_gallery">
        <ul class="project_gallery_list">
          {gallery.slice(0, 9).map((image, index) => (
            <li
              class="project_gallery_item"
              data-reveal="scale"
              style={`--reveal-delay: ${0.2 + index * 0.08}s`}
            >
              <button
                class="project_gallery_button"
                type="button"
                data-image={index}
                aria-label={`${t("gallery.enlarge")} ${index + 1}`}
              >
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[480, 800, 1200]}
                  sizes="(width >= 48rem) 33vw, 100vw"
                  loading={index < 4 ? "eager" : "lazy"}
                />
                <span class="project_gallery_caption">
                  <span>{image.alt}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="project_documents">
        <SectionTitle
          variant="sub"
          title={m.documentsTitle}
          text={m.documentsDescription}
        />
        <div class="project_documents_card" data-reveal="scale">
          <div class="project_documents_glow" />
          <button
            class="project_documents_icon"
            type="button"
            data-document="0"
            aria-label={documents[0].name}
          >
            <span aria-hidden="true">📄</span>
          </button>
          <ul class="project_documents_list">
            {documents.slice(0, 5).map((document, index) => (
              <li>
                <button
                  class="project_documents_item"
                  type="button"
                  data-document={index}
                >
                  <span class="project_documents_dot" />
                  <span class="project_documents_name">{document.name}</span>
                  <span class="project_documents_arrow" aria-hidden="true">
                    →
                  </span>
                </button>
              </li>
            ))}
            {documents.length > 5 && (
              <li>
                <button
                  class="project_documents_item more"
                  type="button"
                  data-document="5"
                >
                  <span class="project_documents_dot" />
                  <span>
                    +{documents.length - 5} {m.moreDocuments}
                  </span>
                </button>
              </li>
            )}
          </ul>
          <p class="project_documents_hint">{m.clickToView}</p>
        </div>
      </div>

      <div class="project_location">
        <h3
          class="project_location_title text-gold-gradient"
          data-reveal="down"
        >
          {m.locationTitle}
        </h3>
        <div class="project_location_layout">
          <div class="project_location_text" data-reveal="left">
            <p class="project_location_description">{m.locationDescription}</p>
            <p class="project_location_distance">{m.locationDistance}</p>
          </div>
          <div
            class="project_location_map"
            data-reveal="right"
            style="--reveal-delay: 0.3s"
          >
            <LocationMap label={m.googleMapsLink} />
          </div>
        </div>
      </div>

      <ul class="project_features">
        {features.map((feature, index) => (
          <li
            class="project_feature"
            data-reveal="up"
            style={`--reveal-delay: ${0.3 + index * 0.15}s`}
          >
            <h3 class="project_feature_title">{feature.title}</h3>
            <p class="project_feature_text">{feature.text}</p>
            <span class="gold-bar" />
          </li>
        ))}
      </ul>

      <div class="project_cta">
        <h3 class="project_cta_title" data-reveal="down">
          {m.ctaTitle}
        </h3>
        <p
          class="project_cta_text"
          data-reveal="up"
          style="--reveal-delay: 0.2s"
        >
          {m.ctaDescription}
        </p>
        <div data-reveal="up" style="--reveal-delay: 0.3s">
          <GoldButton href={`${home}#contact`}>{m.contactButton}</GoldButton>
        </div>
      </div>
    </div>

    <dialog class="project_lightbox image" aria-label={m.projectTitle}>
      <div class="project_lightbox_frame">
        <img class="project_lightbox_image" alt="" />
        <button
          class="project_lightbox_close"
          type="button"
          aria-label={m.back}
        >
          ✕
        </button>
        <button
          class="project_lightbox_step previous"
          type="button"
          aria-label={t("gallery.previous")}
        >
          &#10094;
        </button>
        <button
          class="project_lightbox_step next"
          type="button"
          aria-label={t("gallery.next")}
        >
          &#10095;
        </button>
        <p class="project_lightbox_info">
          <span class="project_lightbox_count" />
        </p>
      </div>
    </dialog>

    <dialog class="project_lightbox document" aria-label={m.documentsTitle}>
      <div class="project_lightbox_frame">
        <iframe class="project_lightbox_document" title={m.documentsTitle} />
        <button
          class="project_lightbox_close"
          type="button"
          aria-label={m.back}
        >
          ✕
        </button>
        <button
          class="project_lightbox_step previous"
          type="button"
          aria-label={t("gallery.previous")}
        >
          &#10094;
        </button>
        <button
          class="project_lightbox_step next"
          type="button"
          aria-label={t("gallery.next")}
        >
          &#10095;
        </button>
        <p class="project_lightbox_info">
          <span class="project_lightbox_name" />
          <span class="project_lightbox_divider" />
          <span class="project_lightbox_count" />
        </p>
      </div>
    </dialog>

    <script
      type="application/json"
      class="project_data"
      set:html={JSON.stringify({ images: enlarged, documents })}
    />
  </section>
)}

<script>
  type Item = { src?: string; href?: string; alt?: string; name?: string };

  const section = document.querySelector<HTMLElement>(".project_wrap");
  const source = section?.querySelector(".project_data")?.textContent;

  if (section && source) {
    const data = JSON.parse(source) as { images: Item[]; documents: Item[] };

    const setUp = (
      dialog: HTMLDialogElement | null,
      items: Item[],
      triggers: string,
      show: (item: Item) => void,
      clear: () => void,
    ) => {
      if (!dialog) return;

      let current = 0;
      const count = dialog.querySelector(".project_lightbox_count");

      const render = () => {
        show(items[current]);
        if (count) count.textContent = `${current + 1} / ${items.length}`;
      };

      const step = (by: number) => {
        current = (current + by + items.length) % items.length;
        render();
      };

      for (const trigger of section.querySelectorAll<HTMLElement>(triggers)) {
        trigger.addEventListener("click", () => {
          current = Number(
            trigger.dataset.image ?? trigger.dataset.document ?? 0,
          );
          render();
          dialog.showModal();
        });
      }

      dialog
        .querySelector(".project_lightbox_close")
        ?.addEventListener("click", () => dialog.close());
      dialog
        .querySelector(".previous")
        ?.addEventListener("click", () => step(-1));
      dialog.querySelector(".next")?.addEventListener("click", () => step(1));

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") step(-1);
        if (event.key === "ArrowRight") step(1);
      });

      dialog.addEventListener("close", clear);
    };

    const imageDialog = section.querySelector<HTMLDialogElement>(
      ".project_lightbox.image",
    );
    const image = imageDialog?.querySelector<HTMLImageElement>(
      ".project_lightbox_image",
    );

    setUp(
      imageDialog,
      data.images,
      "[data-image]",
      (item) => {
        if (!image) return;
        image.src = item.src ?? "";
        image.alt = item.alt ?? "";
      },
      () => image?.removeAttribute("src"),
    );

    const documentDialog = section.querySelector<HTMLDialogElement>(
      ".project_lightbox.document",
    );
    const frame = documentDialog?.querySelector<HTMLIFrameElement>(
      ".project_lightbox_document",
    );
    const name = documentDialog?.querySelector(".project_lightbox_name");

    setUp(
      documentDialog,
      data.documents,
      "[data-document]",
      (item) => {
        if (frame) frame.src = item.href ?? "";
        if (frame) frame.title = item.name ?? "";
        if (name) name.textContent = item.name ?? "";
      },
      () => frame?.removeAttribute("src"),
    );
  }
</script>

<style is:global>
  @layer components {
    /* Gallery */
    .project_gallery {
      margin-inline: 1rem;
      padding: 0.25rem;
      background: var(--gold-gradient);
      box-shadow: 0 0 1.25rem var(--gold-glow);
    }

    .project_gallery_list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0;
      list-style: none;

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .project_gallery_item {
      position: relative;
      aspect-ratio: 16 / 10;
    }

    .project_gallery_button {
      position: absolute;
      inset: 0;
      width: 100%;
      overflow: hidden;
      cursor: pointer;
      transition:
        transform 300ms,
        box-shadow 300ms;

      & img {
        width: 100%;
        height: 100%;
        object-fit: fill;
      }

      @media (hover: hover) {
        &:hover {
          z-index: 2;
          transform: scale(1.03);
          box-shadow:
            0 0.625rem 1.5625rem rgb(0 0 0 / 0.25),
            0 0 0.9375rem var(--brand-500);

          & .project_gallery_caption {
            opacity: 1;
          }

          & .project_gallery_caption span {
            opacity: 1;
            transform: none;
          }
        }
      }

      &:active {
        transform: scale(0.98);
      }
    }

    .project_gallery_caption {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.1));
      color: var(--light-100);
      opacity: 0;
      transition: opacity 300ms;

      & span {
        position: absolute;
        inset: auto 0.5rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 300;
        line-height: 1rem;
        text-align: left;
        opacity: 0;
        transform: translateY(1.25rem);
        transition:
          opacity 300ms 100ms,
          transform 300ms 100ms;
      }
    }

    /* Documents */
    .project_documents {
      margin-top: 5rem;
    }

    .project_documents_card {
      position: relative;
      width: calc(100% - 2rem);
      max-width: 24rem;
      margin-inline: auto;
      padding: 0.75rem;
      background: linear-gradient(
        135deg,
        rgb(0 0 0 / 0.4) 0%,
        rgb(59 58 58 / 0.8) 25%,
        rgb(111 109 107 / 0.6) 75%,
        rgb(0 0 0 / 0.3) 100%
      );
      border: 0.1875rem solid var(--brand-500);
      border-radius: var(--radius-main);
      box-shadow:
        inset 0 0.0625rem 2.5rem rgb(212 175 55 / 0.1),
        0 0.5rem 2rem rgb(0 0 0 / 0.3);
      overflow: hidden;
      backdrop-filter: blur(0.25rem);

      @media (width >= 40rem) {
        padding: 1rem;
      }

      @media (width >= 64rem) {
        padding: 1.25rem;
      }

      @media (hover: hover) {
        &.is-revealed {
          transition:
            transform 300ms,
            box-shadow 300ms;
        }

        &:hover {
          transform: scale(1.02);
          box-shadow:
            0 0.9375rem 2.1875rem rgb(0 0 0 / 0.4),
            0 0 1.25rem var(--brand-500);

          & .project_documents_glow {
            opacity: 0.1;
          }

          & .project_documents_icon {
            transform: scale(1.1);
          }
        }
      }
    }

    .project_documents_glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at center,
        var(--brand-500) 0%,
        transparent 70%
      );
      opacity: 0.05;
      transition: opacity 500ms;
      pointer-events: none;
    }

    .project_documents_icon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 4rem;
      height: 4rem;
      margin: 0 auto 1.5rem;
      background: linear-gradient(
        135deg,
        rgb(59 58 58 / 0.9),
        rgb(111 109 107 / 0.7)
      );
      border: 0.125rem solid var(--brand-500);
      border-radius: 0.75rem;
      box-shadow:
        0 0.5rem 1.5625rem rgb(0 0 0 / 0.4),
        inset 0 0.0625rem 1.25rem rgb(212 175 55 / 0.1);
      font-size: 1.5rem;
      cursor: pointer;
      transition: transform 300ms;

      @media (width >= 40rem) {
        width: 4.5rem;
        height: 4.5rem;
        margin-bottom: 2rem;
        font-size: 1.875rem;
      }

      @media (width >= 64rem) {
        width: 5rem;
        height: 5rem;
        font-size: 2.25rem;
      }
    }

    .project_documents_list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0;
      list-style: none;

      @media (width >= 40rem) {
        gap: 0.5rem;
      }
    }

    .project_documents_item {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 0.375rem 0.5rem;
      color: rgb(255 255 255 / 0.9);
      border-radius: 0.375rem;
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
      line-height: 1rem;
      letter-spacing: 0.025em;
      cursor: pointer;
      transition:
        background-color 200ms,
        transform 200ms;

      @media (width >= 40rem) {
        padding: 0.5rem 0.625rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
      }

      &.more {
        color: rgb(255 255 255 / 0.7);
        font-weight: 300;
        font-style: italic;
        letter-spacing: 0;

        & .project_documents_dot {
          background: var(--brand-500);
          box-shadow: none;
          opacity: 0.7;
        }
      }

      @media (hover: hover) {
        &:hover {
          background-color: rgb(255 255 255 / 0.1);
          color: var(--light-100);
          transform: translateX(0.25rem);

          & .project_documents_arrow {
            opacity: 1;
          }

          & .project_documents_dot {
            transform: scale(1.25);
          }
        }
      }
    }

    .project_documents_dot {
      flex-shrink: 0;
      width: 0.5rem;
      height: 0.5rem;
      margin-right: 0.75rem;
      background: var(--gold-gradient);
      border-radius: 50%;
      box-shadow: 0 0 0.5rem rgb(212 175 55 / 0.4);
      transition: transform 200ms;

      @media (width >= 40rem) {
        margin-right: 1rem;
      }
    }

    .project_documents_name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .project_documents_arrow {
      display: none;
      margin-left: auto;
      color: var(--brand-500);
      font-size: 0.75rem;
      opacity: 0;
      transition: opacity 200ms;

      @media (width >= 40rem) {
        display: inline;
      }
    }

    .project_documents_hint {
      position: relative;
      margin-top: 1rem;
      color: rgb(255 255 255 / 0.5);
      font-size: 0.75rem;
      font-weight: 200;
      line-height: 1.5rem;
      text-align: center;

      @media (width >= 40rem) {
        margin-top: 1.25rem;
      }

      @media (prefers-reduced-motion: no-preference) {
        animation: project-hint 3s ease-in-out infinite;
      }
    }

    @keyframes project-hint {
      0%,
      100% {
        opacity: 0.5;
      }

      50% {
        opacity: 0.8;
      }
    }

    /* Location */
    .project_location {
      margin-top: 6rem;
    }

    .project_location_title {
      margin-bottom: 3rem;
      font-size: 2.1875rem;
      font-weight: var(--primary-bold);
      line-height: 1.5;
      text-align: center;
    }

    .project_location_layout {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4rem;
      margin-inline: 1rem;

      @media (width >= 64rem) {
        flex-direction: row;
      }
    }

    .project_location_text,
    .project_location_map {
      width: 100%;

      @media (width >= 64rem) {
        width: 50%;
      }
    }

    .project_location_text {
      text-align: center;

      @media (width >= 64rem) {
        text-align: right;
      }
    }

    .project_location_description {
      margin-bottom: 2rem;
      font-size: 1.15625rem;
      line-height: 2rem;

      @media (width >= 64rem) {
        font-size: 1.40625rem;
      }
    }

    .project_location_distance {
      font-size: 1.15625rem;
      line-height: 1.5;

      @media (width >= 64rem) {
        font-size: 1.25rem;
      }
    }

    /* Features */
    .project_features {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin: 5rem 1rem 0;
      padding: 0;
      list-style: none;

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .project_feature {
      padding: 2rem;
      background-color: rgb(255 255 255 / 0.05);
      border: 0.0625rem solid var(--brand-500);
      border-radius: var(--radius-main);
      overflow: hidden;
      backdrop-filter: blur(0.25rem);

      @media (hover: hover) {
        &.is-revealed {
          transition:
            transform 300ms,
            box-shadow 300ms,
            background-color 300ms;
          transition-delay: 0s;
        }

        &:hover {
          background-color: rgb(255 255 255 / 0.08);
          transform: translateY(-0.625rem);
          box-shadow:
            0 0.9375rem 1.875rem rgb(0 0 0 / 0.2),
            0 0 0.9375rem var(--brand-500);
        }
      }
    }

    .project_feature_title {
      margin-bottom: 1rem;
      color: var(--brand-500);
      font-size: 1.25rem;
      font-weight: var(--primary-medium);
      line-height: 1.75rem;
    }

    .project_feature_text {
      font-size: 1.15625rem;
      line-height: 1.5;
    }

    /* Call to action */
    .project_cta {
      margin-top: 5rem;
      text-align: center;
    }

    .project_cta_title {
      margin-bottom: 1.5rem;
      color: var(--brand-500);
      font-size: 1.875rem;
      font-weight: var(--primary-medium);
      line-height: 2.25rem;
      text-shadow: 0 0 0.625rem var(--gold-glow);
    }

    .project_cta_text {
      margin: 0 1rem 2rem;
      font-size: 1.125rem;
      line-height: 1.75rem;

      @media (width >= 64rem) {
        margin-inline: 10%;
      }
    }

    /* Lightbox */
    .project_lightbox {
      width: 100vw;
      max-width: none;
      height: 100vh;
      max-height: none;
      margin: 0;
      padding: 1rem;
      background: rgb(0 0 0 / 0.95);
      border: 0;
      backdrop-filter: blur(0.25rem);

      &[open] {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      &::backdrop {
        background: transparent;
      }
    }

    .project_lightbox_frame {
      position: relative;
      width: 90vw;
      max-width: 72rem;
      height: 80vh;
      border: 0.125rem solid var(--brand-500);
      box-shadow: 0 0 1.875rem var(--gold-glow);
    }

    .project_lightbox_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .project_lightbox_document {
      width: 100%;
      height: 100%;
      background: #fff;
      border: 0;
      border-radius: var(--radius-main);
    }

    .project_lightbox_close,
    .project_lightbox_step {
      position: absolute;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      border: 0.0625rem solid var(--brand-500);
      border-radius: 50%;
      cursor: pointer;
      transition:
        transform 300ms,
        background-color 300ms,
        box-shadow 300ms;

      @media (hover: hover) {
        &:hover {
          background-color: rgb(0 0 0 / 0.7);
        }
      }
    }

    .project_lightbox_close {
      top: 2rem;
      right: 1rem;
      width: 2.5rem;
      height: 2.5rem;
      background-color: rgb(0 0 0 / 0.5);

      @media (hover: hover) {
        &:hover {
          transform: scale(1.1);
        }
      }
    }

    .project_lightbox_step {
      top: 50%;
      width: 3rem;
      height: 3rem;
      background-color: rgb(0 0 0 / 0.3);
      transform: translateY(-50%);

      &.previous {
        left: 1rem;
      }

      &.next {
        right: 1rem;
      }

      @media (hover: hover) {
        &:hover {
          transform: translateY(-50%) scale(1.1);
          box-shadow: 0 0 0.9375rem var(--brand-500);
        }
      }
    }

    .project_lightbox_info {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      display: flex;
      align-items: center;
