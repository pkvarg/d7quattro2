---
import { Image } from "astro:assets";
import GoldButton from "@/components/content/GoldButton.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Script line above the heading. */
  title: string;
  /** Page heading. */
  heading: string;
  /** Gold-accented end of the heading. */
  headingAccent?: string;
  /** Body text lines. */
  lines?: string[];
  /** Button label, shown on phones. Omit to hide the button. */
  buttonLabel?: string;
  /** Button destination. */
  buttonHref?: string;
  /** Background image. */
  image: ImageMetadata;
}

const {
  render = true,
  title,
  heading,
  headingAccent,
  lines = [],
  buttonLabel,
  buttonHref,
  image,
} = Astro.props;
---

{render && heading && (
  <section class="hero-home_wrap">
    <div class="hero-home_media">
      <Image
        class="hero-home_image"
        src={image}
        alt=""
        widths={[768, 1280, 1920, image.width]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-home_shade" />
    </div>
    <div class="hero-home_content">
      <p class="hero-home_title">{title}</p>
      <h1 class="hero-home_heading">
        {heading}{" "}
        {headingAccent && (
          <span class="hero-home_accent text-gold-gradient">
            {headingAccent}
          </span>
        )}
      </h1>
      {lines.length > 0 && (
        <p class="hero-home_text">
          {lines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )}
      {buttonLabel && (
        <div class="hero-home_action">
          <GoldButton href={buttonHref}>{buttonLabel}</GoldButton>
        </div>
      )}
    </div>
  </section>
)}

<style is:global>
  @layer components {
    .hero-home_wrap {
      position: relative;
      width: 100%;
      height: 100vh;
      background-color: #000;
      color: var(--light-100);
      overflow: hidden;
    }

    .hero-home_media {
      position: absolute;
      inset: 0;
    }

    .hero-home_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;

      @media (width > 48rem) {
        object-fit: fill;
      }
    }

    .hero-home_shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to top,
        rgb(11 11 11 / 0.196),
        rgb(10 10 10 / 0.569),
        rgb(10 10 10 / 0.067)
      );
    }

    .hero-home_content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      margin: 45% 1rem 0;

      @media (width >= 64rem) {
        margin: 17.5% 15% 0;
      }
    }

    .hero-home_title {
      margin-bottom: 1rem;
      font-family: var(--script-family);
      font-size: 1.875rem;
      font-style: italic;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 0.09em;
      text-shadow: 0.0625rem 0.0625rem 0.125rem rgb(0 0 0 / 0.3);

      @media (width >= 64rem) {
        font-size: 6.25rem;
      }
    }

    .hero-home_heading {
      margin-bottom: 1rem;
      font-size: 1.40625rem;
      font-weight: var(--primary-bold);
      line-height: 1.5;

      @media (width >= 64rem) {
        font-size: 3.125rem;
      }
    }

    .hero-home_text {
      margin-bottom: 2rem;
      font-size: 1.25rem;
      font-weight: var(--primary-medium);
      line-height: 1.5;

      @media (width >= 64rem) {
        font-size: 1.5625rem;
        line-height: 1.75rem;
      }
    }

    .hero-home_action {
      @media (width >= 48rem) {
        display: none;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero-home_action {
        animation: hero-home-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.05s both;
      }

      .hero-home_media {
        animation: hero-home-media 1.2s ease-out both;
      }

      .hero-home_title,
      .hero-home_heading,
      .hero-home_text {
        animation: hero-home-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .hero-home_title {
        animation-delay: 0.3s;
      }

      .hero-home_heading {
        animation-delay: 0.55s;
      }

      .hero-home_text {
        animation-delay: 0.8s;
      }

      .hero-home_accent {
        display: inline-block;
        animation: hero-home-accent 0.6s ease-out 1.35s both;
      }
    }

    @keyframes hero-home-media {
      from {
        opacity: 0.4;
        transform: scale(1.05);
      }
    }

    @keyframes hero-home-rise {
      from {
        opacity: 0;
        transform: translateY(3.125rem);
      }
    }

    @keyframes hero-home-accent {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
    }
  }
</style>
