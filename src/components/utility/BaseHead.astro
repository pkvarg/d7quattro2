---
import { Font } from "astro:assets";
import { SITE_NAME } from "@/consts.ts";
import { getMessages } from "@/i18n/messages.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_TAGS,
  toLocale,
  translatePath,
  type Locale,
} from "@/i18n/locales.ts";

type Props = SeoProps & {
  /** Locales this page exists in. Defaults to every locale. */
  translations?: readonly Locale[];
};

const {
  title,
  description,
  image = "/og-image.jpg",
  type = "website",
  noindex,
  translations = LOCALES,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const locale = toLocale(Astro.currentLocale);
const m = getMessages(locale);
const pageDescription =
  description ?? `${m.heroDescription1} ${m.heroDescription2}`;
const alternates = translations.flatMap((alternate) => {
  const path = translatePath(Astro.url.pathname, alternate);
  return path ? { locale: alternate, href: new URL(path, Astro.site) } : [];
});
const fallback = alternates.find(
  (alternate) => alternate.locale === DEFAULT_LOCALE,
);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-gilda" preload />
<Font cssVariable="--font-figtree" preload />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}
{alternates.map((alternate) => (
  <link
    rel="alternate"
    hreflang={LOCALE_TAGS[alternate.locale]}
    href={alternate.href}
  />
))}
{fallback && <link rel="alternate" hreflang="x-default" href={fallback.href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace("-", "_")} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
