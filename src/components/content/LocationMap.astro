---
import { Image } from "astro:assets";
import aerial from "@/assets/images/location-aerial.jpg";
import { toLocale } from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Link text below the address. */
  label: string;
}

const { render = true, label } = Astro.props;

const m = getMessages(toLocale(Astro.currentLocale));
const address = `Edelhofgasse, Wolfsthal, 2412 ${m.austria}`;
const href = "https://www.google.com/maps?q=48.133239,16.999667";
---

{render && (
  <div class="location-map_wrap">
    <a
      class="location-map_link"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        class="location-map_image"
        src={aerial}
        alt={m.locationTitle}
        widths={[480, 800, 1344]}
        sizes="(width >= 64rem) 42rem, 100vw"
      />
      <span class="location-map_info">
        <span class="location-map_address">{address}</span>
        <span class="location-map_label">{label}</span>
      </span>
      <svg
        class="location-map_pin"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
        />
        <circle cx="12" cy="10.5" r="1.5" fill="#d4af37" />
      </svg>
      <svg
        class="location-map_compass"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path d="M12 2V22" stroke="currentColor" stroke-width="0.75" />
        <path d="M2 12H22" stroke="currentColor" stroke-width="0.75" />
        <path d="M17 12L12 7L7 12L12 17L17 12Z" fill="currentColor" />
      </svg>
    </a>
  </div>
)}

<style is:global>
  @layer components {
    .location-map_wrap {
      max-width: 42rem;
      margin: 3rem auto;
      padding: 0.125rem;
      background: var(--gold-gradient);
      box-shadow: 0 0 1.25rem var(--gold-glow);
    }

    .location-map_link {
      position: relative;
      display: block;
      color: var(--light-100);
      overflow: hidden;
      transition:
        transform 500ms,
        box-shadow 500ms;

      @media (hover: hover) {
        &:hover {
          transform: scale(1.01);
          box-shadow:
            0 0.625rem 1.5625rem rgb(0 0 0 / 0.2),
            0 0 0.9375rem var(--brand-500);
        }
      }
    }

    .location-map_image {
      width: 100%;
      height: 24rem;
      object-fit: cover;

      @media (width >= 64rem) {
        height: 27rem;
      }
    }

    .location-map_info {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem;
      background: linear-gradient(
        to right,
        #85682c,
        #b69752,
        #8a6e31,
        #aa8e47,
        #7a5c1e
      );
      border-top: 0.125rem solid var(--brand-500);
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    .location-map_address {
      font-weight: 300;
      letter-spacing: 0.025em;
    }

    .location-map_label {
      color: #fcf6ba;
      font-weight: 200;
    }

    .location-map_pin {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3rem;
      height: 3rem;
      color: #e63946;
      filter: drop-shadow(0 0 0.375rem var(--brand-500));
      transform: translate(-50%, -50%);
    }

    .location-map_compass {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 2.5rem;
      height: 2.5rem;
      color: var(--brand-500);
      opacity: 0.75;
    }
  }
</style>
