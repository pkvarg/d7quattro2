---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import { localizePath, toLocale } from "@/i18n/locales.ts";
import { useTranslations } from "@/i18n/ui.ts";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout
  title={t("notFound.title")}
  description={t("notFound.description")}
  overlap={true}
  noindex={true}
>
  <slot name="head" slot="head" />
  <Section paddingTop="navoverlap" paddingBottom="navoverlap" class="flex-grow">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h1" maxWidth={17}>
        {t("notFound.heading")}
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        {t("notFound.text")}
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={localizePath(locale)}>
          {t("notFound.back")}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
