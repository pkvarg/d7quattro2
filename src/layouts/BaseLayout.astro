---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import CookieConsent from "@/components/global/CookieConsent.astro";
import ConstructionNotice from "@/components/global/ConstructionNotice.astro";
import RevealObserver from "@/components/utility/RevealObserver.astro";
import { UNDER_CONSTRUCTION } from "@/consts.ts";
import type { SeoProps } from "@/types.ts";
import { toLocale, type Locale } from "@/i18n/locales.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /** Navigation bar. `pages` is the plain bar used on text pages. */
  nav?: "main" | "pages";
  /** Locales this page exists in. Defaults to every locale. */
  translations?: readonly Locale[];
};

const { theme = "dark", nav = "main", translations, ...seo } = Astro.props;

const locale = toLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale} class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} translations={translations} />
    <slot name="head" />
    <RevealObserver />
  </head>
  <body>
    <SkipLink />
    <Nav variant={nav} translations={translations} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConstructionNotice render={UNDER_CONSTRUCTION} />
    <CookieConsent />
  </body>
</html>
