---
import Layout from "@/layouts/BaseLayout.astro";
import LegalTextBlock from "@/components/content/LegalText.astro";
import type { LegalText } from "@/types.ts";

interface Props {
  /** Legal page content for the current locale. */
  text: LegalText;
}

const { text } = Astro.props;
---

<Layout
  title={text.title}
  description={text.effective}
  theme="light"
  nav="pages"
>
  <LegalTextBlock text={text} />
</Layout>
