---
import NotFoundLayout from "@/layouts/NotFoundLayout.astro";
import { DEFAULT_LOCALE, LOCALES } from "@/i18n/locales.ts";

const others = LOCALES.filter((locale) => locale !== DEFAULT_LOCALE);
---

<NotFoundLayout>
  <script slot="head" is:inline define:vars={{ locales: LOCALES, others }}>
    const first = location.pathname.split("/")[1];
    const preferred = (navigator.languages || [navigator.language])
      .map((tag) => tag.slice(0, 2).toLowerCase())
      .find((tag) => locales.includes(tag));
    if (!locales.includes(first) && others.includes(preferred)) {
      location.replace(`/${preferred}/404/`);
    }
  </script>
</NotFoundLayout>
