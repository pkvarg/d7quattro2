---
import Layout from "@/layouts/BaseLayout.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ProjectMain from "@/components/section/ProjectMain.astro";
import PricesMain from "@/components/section/PricesMain.astro";
import AboutMain from "@/components/section/AboutMain.astro";
import ContactMain from "@/components/section/ContactMain.astro";
import heroImage from "@/assets/images/hero.webp";
import { LOCALES, toLocale } from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const m = getMessages(toLocale(Astro.params.locale));

const contactApi =
  import.meta.env.PUBLIC_CONTACT_API ??
  "https://hono-api.pictusweb.com/api/contact";
---

<Layout title={m.heroTitle}>
  <!-- Hero -->
  <HeroHome
    title={m.heroTitle}
    heading={m.heroSubtitle1}
    headingAccent={m.heroSubtitle2}
    lines={[m.heroDescription1, m.heroDescription2]}
    image={heroImage}
  />
  <!-- Project -->
  <ProjectMain />
  <!-- Prices -->
  <PricesMain />
  <!-- About -->
  <AboutMain />
  <!-- Contact -->
  <ContactMain action={contactApi} />
</Layout>
