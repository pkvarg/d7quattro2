---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import Slider from "@/components/interactive/Slider.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import FactList from "@/components/content/FactList.astro";
import DetailList from "@/components/content/DetailList.astro";
import DocumentList from "@/components/content/DocumentList.astro";
import PriceTable from "@/components/content/PriceTable.astro";
import Quote from "@/components/content/Quote.astro";
import GalleryThumb from "@/components/content/GalleryThumb.astro";
import GalleryViewer from "@/components/content/GalleryViewer.astro";
import heroImage from "@/assets/images/exterior/exterior-4.webp";
import aboutImage from "@/assets/images/exterior/exterior-2.webp";
import locationImage from "@/assets/images/location.jpg";
import {
  LOCALES,
  LOCALE_TAGS,
  localizePath,
  toLocale,
} from "@/i18n/locales.ts";
import { getMessages } from "@/i18n/messages.ts";
import { useTranslations } from "@/i18n/ui.ts";
import { exteriorImages, interiorImages } from "@/utils/gallery.ts";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = toLocale(Astro.params.locale);
const m = getMessages(locale);
const t = useTranslations(locale);
const home = localizePath(locale);

const capitalize = (text: string) =>
  text.charAt(0).toUpperCase() + text.slice(1);

const euro = new Intl.NumberFormat(LOCALE_TAGS[locale], {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
});

const houses = (await getCollection("houses")).sort(
  (a, b) => a.data.number - b.data.number,
);

const plan = (name: string, file: string) => ({
  name,
  href: `/plans/${file}.pdf`,
});

const documents = [
  {
    title: m.documentTypes.grundriss,
    items: [
      plan("Grundriss EG", "grundriss-eg"),
      plan("Grundriss OG", "grundriss-og"),
    ],
  },
  {
    title: m.documentTypes.lageplan,
    items: [
      plan("Lageplan A", "lageplan-a"),
      plan("Lageplan PG", "lageplan-pg"),
    ],
  },
  {
    title: m.documentTypes.wohnung,
    items: [1, 2, 3, 4].flatMap((unit) => [
      plan(`Wohnung 1-${unit} EG`, `wohnung-1-${unit}-eg`),
      plan(`Wohnung 1-${unit} OG`, `wohnung-1-${unit}-og`),
    ]),
  },
];

const contactApi =
  import.meta.env.PUBLIC_CONTACT_API ??
  "https://hono-api.pictusweb.com/api/contact";

const subjects = {
  sk: "Správa z d7quattro.at",
  de: "Nachricht von d7quattro.at",
  en: "Message from d7quattro.at",
};
---

<Layout
  title={m.heroTitle}
  socialTitle={m.ogTitle}
  socialDescription={m.ogDescription}
  overlap={true}
>
  <HeroHome
    kicker={m.heroTitle}
    heading={`${m.heroSubtitle1} ${m.heroSubtitle2}`}
    text={`${m.heroDescription1} ${m.heroDescription2}`}
    buttonLabel={m.contactButton}
    buttonHref={`${home}#contact`}
    image={heroImage}
  />

  <!-- Project -->
  <Section id="project">
    <ContentWrapper variant="columns">
      <Heading tag="h2">{m.projectTitle}</Heading>
      <Paragraph slot="column2" variant="large" maxWidth={60}>
        {m.projectDescription}
      </Paragraph>
    </ContentWrapper>
    <Tabs>
      <Fragment slot="links">
        <TabLink>{capitalize(m.exterior)}</TabLink>
        <TabLink>{capitalize(m.interior)}</TabLink>
      </Fragment>
      <div>
        <Slider
          label={capitalize(m.exterior)}
          markerLabel={t("gallery.slide")}
          previousLabel={t("gallery.previous")}
          nextLabel={t("gallery.next")}
          medium={2}
          large={2.2}
        >
          {exteriorImages.map((image, index) => (
            <GalleryThumb
              src={image}
              alt={`${capitalize(m.exterior)} ${index + 1}`}
              viewer="gallery-exterior"
              index={index}
              label={t("gallery.enlarge")}
            />
          ))}
        </Slider>
      </div>
      <div>
        <Slider
          label={capitalize(m.interior)}
          markerLabel={t("gallery.slide")}
          previousLabel={t("gallery.previous")}
          nextLabel={t("gallery.next")}
          medium={2}
          large={2.2}
        >
          {interiorImages.map((image, index) => (
            <GalleryThumb
              src={image}
              alt={`${capitalize(m.interior)} ${index + 1}`}
              viewer="gallery-interior"
              index={index}
              label={t("gallery.enlarge")}
            />
          ))}
        </Slider>
      </div>
    </Tabs>
  </Section>

  <!-- Location -->
  <Section id="location" paddingTop="none">
    <ContentWrapper variant="columns">
      <Heading tag="h2" variant="h3">
        {m.locationTitle}
      </Heading>
      <Paragraph maxWidth={54}>{m.locationDescription}</Paragraph>
      <FactList
        items={[
          { value: `15 ${m.factMinutes}`, label: m.factBratislava },
          { value: `35 ${m.factMinutes}`, label: m.factVienna },
          { value: m.areaSize, label: m.area },
          { value: String(houses.length), label: m.factHouses },
        ]}
      />
      <ButtonWrapper>
        <Button
          element="link"
          emphasis="secondary"
          href="https://www.google.com/maps?q=48.133239,16.999667"
          target="_blank"
          rel="noopener"
        >
          {m.googleMapsLink}
        </Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={locationImage}
        alt={m.locationTitle}
        variant="constrained"
        sizes="(width >= 48rem) 50vw, 100vw"
      />
    </ContentWrapper>
  </Section>

  <!-- Qualities -->
  <Section paddingTop="none">
    <Grid medium={3}>
      <Card
        heading={m.architecturalTitle}
        headingTag="h3"
        text={m.architecturalDescription}
      />
      <Card
        heading={m.qualityTitle}
        headingTag="h3"
        text={m.qualityDescription}
      />
      <Card
        heading={m.sustainableTitle}
        headingTag="h3"
        text={m.sustainableDescription}
      />
    </Grid>
  </Section>

  <!-- Documents -->
  <Section id="documents" paddingTop="none">
    <ContentWrapper>
      <Heading tag="h2" variant="h3">
        {m.documentsTitle}
      </Heading>
      <Paragraph maxWidth={54}>{m.documentsDescription}</Paragraph>
    </ContentWrapper>
    <DocumentList groups={documents} openLabel={m.plansOpen} />
  </Section>

  <!-- Prices -->
  <Section id="prices" theme="light">
    <ContentWrapper variant="columns">
      <Heading tag="h2">{m.pricesTitle}</Heading>
      <Paragraph maxWidth={46}>{m.pricesDescription}</Paragraph>
      <DetailList
        items={[
          { term: m.area, description: m.areaSize },
          { term: m.deposit, description: m.depositAmount },
          { term: m.shortTermRental, description: m.shortTermPrice },
          { term: m.internet, description: m.internetDescription },
          { term: m.furnishing, description: m.furnishingDescription },
          {
            term: m.features,
            description: [
              m.photovoltaic,
              m.electricCharging,
              m.electricMeter,
            ].join(", "),
          },
        ]}
      />
      <PriceTable
        slot="column2"
        caption={m.pricesTitle}
        headings={{
          unit: m.unitName,
          rent: `${m.rentPrice} / ${m.perMonth}`,
          energy: m.energyCost,
        }}
        rows={houses.map((house) => ({
          name: `${m.unitName} ${house.data.number}`,
          rent: euro.format(house.data.rent),
          energy: euro.format(house.data.energy),
        }))}
      />
      <Paragraph slot="column2" variant="small">
        {m.contactForDetails}
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- About -->
  <Section id="about">
    <ContentWrapper variant="columns">
      <Heading tag="h2">{m.navAboutUs}</Heading>
      <Paragraph variant="large" maxWidth={50}>
        {m.philosophy}
      </Paragraph>
      <RichText maxWidth={60}>
        <p>{m.companyDescription}</p>
        <p>{m.companyProcedures}</p>
        <h3 class="text-style-h5">{m.companyPhilosophyTitle}</h3>
        <p>{m.companyPhilosophyText}</p>
      </RichText>
      <Img
        slot="column2"
        src={aboutImage}
        alt={m.projectTitle}
        variant="constrained"
        sizes="(width >= 48rem) 50vw, 100vw"
      />
      <Quote
        slot="column2"
        text={m.homeQuote}
        author={m.founderName}
        role={m.founderTitle}
      />
    </ContentWrapper>
  </Section>

  <!-- Viewing -->
  <Section theme="brand" paddingTop="small" paddingBottom="small">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h3">
        {m.ctaTitle}
      </Heading>
      <Paragraph variant="large" maxWidth={46}>
        {m.ctaDescription}
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={`${home}#contact`}>
          {m.contactButton}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Contact -->
  <Section id="contact">
    <ContentWrapper variant="columns">
      <Heading tag="h2">{m.discussDreamHome}</Heading>
      <Paragraph maxWidth={50}>{m.readyToTransform}</Paragraph>
      <DetailList
        items={[
          {
            term: m.address,
            description: `Feldgasse 3, 2412 Wolfsthal, ${m.austria}`,
          },
          {
            term: m.email,
            description: "info@d7quattro.at",
            href: "mailto:info@d7quattro.at",
          },
          {
            term: m.contactPhone,
            description: "+43 676 374 9858",
            href: "tel:+436763749858",
          },
        ]}
      />
      <Form
        slot="column2"
        name="contact"
        action={contactApi}
        encoding="json"
        honeypot="website"
        successMessage={m.contactSuccess}
        errorMessage={m.contactError}
      >
        <Input
          variant="text"
          label={m.contactName}
          name="name"
          placeholder=""
          required
        />
        <Input
          variant="email"
          label={m.contactEmail}
          name="email"
          placeholder=""
          required
        />
        <Input
          variant="phone"
          label={m.contactPhone}
          name="phone"
          placeholder=""
        />
        <Textarea
          label={m.contactMessage}
          name="mailMessage"
          minLines={3}
          required
        />
        <input type="hidden" name="locale" value={locale} />
        <input type="hidden" name="origin" value="D7QUATTRO" />
        <input type="hidden" name="subject" value={subjects[locale]} />
        <input
          class="sr-only"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <Paragraph variant="small">
          {m.contactAgree}{" "}
          <a href={`${localizePath(locale, "gdpr")}#kontaktformular`}>
            {m.contactGdpr}
          </a>
        </Paragraph>
        <Button type="submit">{m.contactSend}</Button>
      </Form>
    </ContentWrapper>
  </Section>
  <GalleryViewer
    id="gallery-exterior"
    label={capitalize(m.exterior)}
    images={exteriorImages}
  />
  <GalleryViewer
    id="gallery-interior"
    label={capitalize(m.interior)}
    images={interiorImages}
  />
</Layout>
