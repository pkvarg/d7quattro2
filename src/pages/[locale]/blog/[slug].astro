---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";
import FormattedDate from "@/components/utility/FormattedDate.astro";
import { localizePath, type Locale } from "@/i18n/locales.ts";
import { useTranslations } from "@/i18n/ui.ts";
import { parsePostId, type Post } from "@/utils/posts.ts";

interface Props {
  post: Post;
  locale: Locale;
  translations: Locale[];
}

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).map((post) => ({
    post,
    ...parsePostId(post.id),
  }));

  return posts.flatMap(({ post, locale, slug }) =>
    locale
      ? {
          params: { locale, slug },
          props: {
            post,
            locale,
            translations: posts
              .filter((other) => other.slug === slug && other.locale)
              .map((other) => other.locale!),
          },
        }
      : [],
  );
}

const { post, locale, translations } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  translations={translations}
>
  <Section>
    <ContentWrapper>
      <Eyebrow>
        <FormattedDate date={post.data.date} />
      </Eyebrow>
      <Heading tag="h1" maxWidth={24}>
        {post.data.title}
      </Heading>
      <RichText maxWidth={70}>
        <Content />
      </RichText>
      <ButtonWrapper>
        <Button element="link" href={localizePath(locale, "blog")}>
          {t("blog.back")}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
