---
import LegalLayout from "@/layouts/LegalLayout.astro";
import { LOCALES, toLocale } from "@/i18n/locales.ts";
import { impressum } from "@/i18n/impressum.ts";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = toLocale(Astro.params.locale);
---

<LegalLayout text={impressum[locale] ?? impressum.sk} />
